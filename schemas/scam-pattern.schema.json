{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EverSoftLegit/naijascamcorpus/blob/main/schemas/scam-pattern.schema.json",
  "title": "NaijaScamCorpus Scam Pattern Record",
  "description": "A privacy-preserving, pattern-level record. The initial release permits synthetic examples only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "record_version",
    "record_type",
    "countries",
    "languages",
    "channel",
    "scam_family",
    "impersonated_sector",
    "persuasion_tactics",
    "requested_actions",
    "pattern_summary",
    "synthetic_example",
    "source",
    "confidence",
    "review_status",
    "privacy_review",
    "limitations",
    "record_license"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^NSC-[A-Z0-9-]{3,60}$"
    },
    "record_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "record_type": {
      "const": "synthetic_pattern"
    },
    "countries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 35
      }
    },
    "channel": {
      "enum": [
        "sms",
        "messaging_app",
        "email",
        "voice_call",
        "social_media",
        "website",
        "online_ad",
        "in_person",
        "multiple",
        "other",
        "unknown"
      ]
    },
    "scam_family": {
      "enum": [
        "impersonation",
        "advance_fee",
        "investment",
        "employment",
        "romance_relationship",
        "account_takeover",
        "payment_redirection",
        "mobile_money",
        "delivery",
        "charity_disaster",
        "technical_support",
        "other"
      ]
    },
    "impersonated_sector": {
      "enum": [
        "financial_service",
        "government",
        "telecommunications",
        "employer",
        "delivery_logistics",
        "family_or_friend",
        "charity",
        "technology_provider",
        "investment_service",
        "none",
        "other",
        "unknown"
      ]
    },
    "persuasion_tactics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "urgency",
          "fear_or_threat",
          "authority_claim",
          "scarcity",
          "reward_or_prize",
          "social_proof",
          "secrecy",
          "reciprocity",
          "relationship_building",
          "opportunity_claim",
          "confusion_or_overload",
          "impersonation",
          "other"
        ]
      }
    },
    "requested_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "send_money",
          "share_otp",
          "disclose_credentials",
          "click_link",
          "install_app",
          "call_number",
          "share_identity_document",
          "provide_personal_data",
          "approve_transaction",
          "other"
        ]
      }
    },
    "pattern_summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1200
    },
    "synthetic_example": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1200,
      "pattern": "^SYNTHETIC EXAMPLE:"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "reference",
        "published_date",
        "methodology"
      ],
      "properties": {
        "source_kind": {
          "const": "synthetic"
        },
        "reference": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "published_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "methodology": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1000
        }
      }
    },
    "confidence": {
      "const": "not_applicable_synthetic"
    },
    "review_status": {
      "const": "approved_synthetic"
    },
    "privacy_review": {
      "const": "passed"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10,
        "maxLength": 500
      }
    },
    "record_license": {
      "const": "CC-BY-4.0"
    }
  }
}
